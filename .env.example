# Copy to .env (server.ts reads only .env) and fill in values. Never commit .env.

# Gemini API key (server-side only)
GEMINI_API_KEY=
# Gemini models in order of preference, comma-separated (default: gemini-3.8-flash).
# On 429 (quota), 503 (overloaded), 404 (model gone) or timeout the server tries the next one.
# Example: gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash-lite
# List models available to your key: https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=
# Per-model timeout in milliseconds before moving to the next model (default 20000)
GEMINI_MODEL_TIMEOUT_MS=

PORT=3000
APP_URL=

# Optional Supabase persistence
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional fallback LLM provider (OpenAI-compatible)
VITE_FALLBACK_BASE_URL=
VITE_FALLBACK_KEY=
VITE_FALLBACK_MODEL=
