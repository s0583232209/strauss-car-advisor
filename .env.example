# Copy to .env and fill in values. Never commit .env.
# Every variable here is read by the SERVER only (server/config.ts). The client bundle reads no
# environment variables: do not add VITE_* secrets (Vite would put them into the browser bundle).

# --- Model (Gemini) ---
GEMINI_API_KEY=
# Models in order of preference, comma-separated (default: gemini-3.5-flash-lite).
# On 429 (quota), 503 (overloaded), 404 (model gone) or timeout the server tries the next one.
# List models available to your key: https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=
# Per-model timeout in milliseconds before moving to the next model (default 10000)
GEMINI_MODEL_TIMEOUT_MS=

# Optional fallback provider (OpenAI-compatible, e.g. OpenRouter/Groq), server side
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=

# --- Storage ---
# Supabase (production): both required. Use the SERVICE ROLE key; it stays on the server.
# Run supabase/schema.sql first (it enables RLS so the anon key can read nothing).
# Users log in with Supabase Auth (email + password); roles live in the app_users table.
# Without Supabase there is no login and every screen is open (development only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Without Supabase: JSON files in this folder (default .data). Single instance, persistent disk only.
DATA_DIR=

# --- HTTP ---
PORT=3000
# Default: 127.0.0.1 in development, 0.0.0.0 in production
HOST=
# Behind a cloud load balancer set to 1 (or true) so rate limits see the real client IP
TRUST_PROXY=
# Extra origins allowed to call the API (comma-separated). The app's own origin is always allowed.
ALLOWED_ORIGINS=

# Development: AGENT_DEBUG_LOG=off silences the agent trace in the server console
AGENT_DEBUG_LOG=
