    {
      "name": "4. Agent turn (calls Gemini, ~30s)",
      "item": [
        {
          "name": "Send a message",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const lines = pm.response.text().trim().split('\\n').filter(Boolean).map((l) => JSON.parse(l));",
                  "const last = lines[lines.length - 1];",
                  "pm.test('200 NDJSON stream', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/x-ndjson');",
                  "});",
                  "pm.test('ends with a result (not an error)', () => {",
                  "  pm.expect(last.type, last.message).to.eql('result');",
                  "});",
                  "pm.test('the bot answered in the conversation', () => {",
                  "  const msgs = last.session.messages;",
                  "  pm.expect(msgs.length).to.be.at.least(2);",
                  "  pm.expect(msgs[msgs.length - 1].role).to.eql('assistant');",
                  "  pm.expect(msgs[msgs.length - 1].content).to.be.a('string').that.is.not.empty;",
                  "});",
                  "pm.test('finished within the 60s function limit', () => pm.expect(pm.response.responseTime).to.be.below(60000));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{sessionId}}",
                "messages"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"שלום, מה אתה יכול לעשות?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
