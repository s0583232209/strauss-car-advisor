{
  "info": {
    "name": "Strauss Car Advisor - smoke test",
    "description": "Checks that the deployed site responds: client, public API, security, login, conversation and (optional) one agent turn.\n\nVariables: baseUrl (e.g. https://strauss-car-advisor.vercel.app, no trailing slash), email, password.\nPass the password on the command line (--env-var password=...), never save it in a file.\nThe login folder needs a user that exists in Supabase Auth. Folder 4 calls Gemini (about 30s, uses quota).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const bypass = pm.variables.get('vercelBypass');",
          "if (bypass) pm.request.headers.upsert({ key: 'x-vercel-protection-bypass', value: bypass });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://strauss-car-advisor.vercel.app"
    },
    {
      "key": "sessionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Public (no login)",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with status ok', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('ok');",
                  "});",
                  "pm.test('production: no internal details', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.not.have.property('storage');",
                  "  pm.expect(body).to.not.have.property('hasGeminiKey');",
                  "});",
                  "pm.test('security headers', () => {",
                  "  pm.response.to.have.header('Strict-Transport-Security');",
                  "  pm.response.to.have.header('Content-Security-Policy');",
                  "  pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        },
        {
          "name": "Client home page",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 HTML with the app root', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.text()).to.include('<div id=\"root\">');",
                  "});",
                  "pm.test('page has security headers (no framing, CSP)', () => {",
                  "  pm.expect(pm.response.headers.get('X-Frame-Options')).to.eql('DENY');",
                  "  pm.response.to.have.header('Content-Security-Policy');",
                  "  pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
                  "});",
                  "const asset = (pm.response.text().match(new RegExp('assets/[^\"]+[.]js')) || [])[0];",
                  "pm.collectionVariables.set('assetPath', asset || '');",
                  "pm.test('page links a JS bundle', () => pm.expect(asset).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            }
          }
        },
        {
