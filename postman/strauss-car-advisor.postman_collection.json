    {
      "name": "3. Logged in",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with user and role', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const user = pm.response.json();",
                  "  pm.expect(user.email).to.eql(pm.variables.get('email').toLowerCase());",
                  "  pm.expect(['employee', 'rep', 'admin']).to.include(user.role);",
                  "  pm.collectionVariables.set('role', user.role);",
                  "});",
                  "pm.test('cookies are HttpOnly and Secure', () => {",
                  "  const cookies = pm.response.headers.filter((h) => h.key.toLowerCase() === 'set-cookie').map((h) => h.value);",
                  "  pm.expect(cookies.length).to.be.at.least(1);",
                  "  cookies.forEach((c) => { pm.expect(c).to.include('HttpOnly'); pm.expect(c).to.include('Secure'); });",
                  "});",
                  "pm.test('no token in the body', () => {",
                  "  pm.expect(pm.response.text()).to.not.match(/access_?token|refresh_?token/i);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
