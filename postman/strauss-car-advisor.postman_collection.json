                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('javascript');",
                  "  pm.expect(pm.response.headers.get('Cache-Control')).to.include('immutable');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{assetPath}}",
              "host": [
                "{{baseUrl}}"
              ],
